rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /news/{id} {
      allow read: if true;            // public
      allow create, update, delete: if request.auth != null; // any signed-in user
    }
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
    match /catalogBrands/{id} {
      allow read: if true;            // public (catalog page brand sections)
      allow create, update, delete: if request.auth != null; // admin only
    }
    // Brand events (e.g. Jungnammi). Path: brand_events/{brandId}/events/{eventId}.
    // Restores access that lived only in the Firebase Console and was dropped when
    // the repo rules were deployed over production. Public read, admin (signed-in) write.
    match /brand_events/{brandId} {
      allow read: if true;            // public (event display, e.g. /event/jungnammi)
      allow create, update, delete: if request.auth != null; // admin only
      match /events/{eventId} {
        allow read: if true;          // public (event list)
        allow create, update, delete: if request.auth != null; // admin only
      }
    }
    match /settings/{id} {
      allow read: if true;            // public (for banner display on frontend)
      allow create, update, delete: if request.auth != null; // admin only
    }
  }
}
